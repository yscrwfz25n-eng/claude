      "type": "av-faq",
      "settings": {
        "scheme": "bordo2"
      },
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "¿Se nota bajo la ropa?",
            "answer": "<p>No. Es transparente y finita: bien aplicada, no se ve bajo la ropa.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "¿Cuánto dura?",
            "answer": "<p>Hasta 16 horas. El efecto es mientras la tenés puesta, no es permanente.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "¿Puedo mojarla?",
            "answer": "<p>Sí, resiste el agua y la transpiración.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "¿Cómo se saca?",
            "answer": "<p>Mojala con agua tibia o poné unas gotas de aceite, sostené la piel y despegala despacio.</p>"
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "¿Cuánto tarda el envío?",
            "answer": "<p>Despachamos en 24–48 hs hábiles a todo el país con seguimiento de Andreani. Retiro gratis en sucursal desde $35.000 y envío gratis a domicilio desde $49.000.</p>"
          }
        },
        "question_6": {
          "type": "question",
          "settings": {
            "question": "¿Puedo cancelar mi compra?",
            "answer": "<p>Sí. Tenés 10 días corridos desde que recibís tu pedido para arrepentirte. Escribinos por WhatsApp y te ayudamos.</p>"
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
        "question_3",
        "question_4",
        "question_5",
        "question_6"
      ]
    },
