    "steps": {
      "type": "av-steps",
      "settings": {
        "scheme": "bordo"
      },
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "title": "Pegala",
            "text": "Piel limpia y seca. Despegá el protector sin tocar el adhesivo."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "title": "Levantá",
            "text": "Subí suavemente la piel y apoyá la tira."
          }
