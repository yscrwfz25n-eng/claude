            "fallback": "av-z-piernas-2.jpg",
            "text": "Piernas más lisas y firmes al instante, con la cinta puesta."
          }
        },
        "item_2": {
          "type": "item",
          "settings": {
            "zone": "Abdomen",
            "fallback": "av-z-abdomen-1.jpg",
            "text": "El abdomen se ve más plano y parejo bajo la ropa ajustada."
          }
        },
        "item_3": {
          "type": "item",
          "settings": {
            "zone": "Brazos",
            "fallback": "av-z-brazos-1.jpg",
            "text": "Brazos más firmes para usar musculosas sin pensarlo."
          }
        }
