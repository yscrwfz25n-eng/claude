{%- comment -%}
  Aurum Skin · carga los estilos y el movimiento de las secciones "Aurum".
  Va en layout/theme.liquid, justo antes de </body>:  {% render 'aurum-motion' %}
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&display=swap">
{{ 'aurum.css' | asset_url | stylesheet_tag }}

{%- if template.name == 'index' -%}
  <script>document.body.classList.add('aurum-night');</script>
{%- endif -%}

<div class="au-star" aria-hidden="true">
  <svg viewBox="0 0 100 100"><defs><radialGradient id="au-sg" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#FFFFFF"/><stop offset=".55" stop-color="#FFE9EA"/><stop offset="1" stop-color="#F4B9BF"/></radialGradient></defs><path d="M50 0 C54 34 66 46 100 50 C66 54 54 66 50 100 C46 66 34 54 0 50 C34 46 46 34 50 0Z" fill="url(#au-sg)"/></svg>
</div>

<script src="{{ 'aurum.js' | asset_url }}" defer></script>
