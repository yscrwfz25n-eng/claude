{%- comment -%} Aurum · Rutina: banner "Tu rutina glow en 3 pasos" con foto y pasos que llevan a cada producto. Cada paso es un bloque. {%- endcomment -%}
<section class="au-sec au-sec--{{ section.settings.capsule }} au-rut">
  <div class="au-rut__grid{% if section.settings.image == blank %} au-rut__grid--solo{% endif %}">
    {%- if section.settings.image != blank -%}
      <div class="au-rut__photo au-reveal">
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', sizes: '(max-width: 760px) 100vw, 480px', alt: section.settings.heading }}
      </div>
    {%- endif -%}

    <div class="au-rut__body">
      <div class="au-rut__head au-reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="au-rut__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="au-twinkle">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="au-rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>

      <ol class="au-rut__steps">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          <li class="au-rut__step au-reveal" {{ block.shopify_attributes }}>
            <span class="au-rut__num" aria-hidden="true">{{ forloop.index }}</span>
            <div class="au-rut__txt">
              <b>{{ block.settings.label }}</b>
              {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              {%- if p != blank -%}
                <a class="au-rut__prod" href="{{ p.url }}">
                  {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 90 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
                  <span>{{ p.title | split: ' · ' | first }}</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

<style>
  .au-rut__grid{display:grid; grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr); gap:clamp(1.4rem,4vw,3rem); align-items:center}
  .au-rut__grid--solo{grid-template-columns:minmax(0,1fr); max-width:720px; margin-inline:auto}
  .au-rut__photo{border-radius:clamp(26px,4vw,40px); overflow:hidden; aspect-ratio:4/5; background:rgba(59,4,8,.08)}
  .au-sec .au-rut__photo img{width:100%; height:100%; object-fit:cover}
  .au-rut__head{display:grid; gap:.8rem; margin-bottom:clamp(1.1rem,2.6vw,1.6rem)}
  .au-rut__eyebrow{font-size:.78rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--au-pink); opacity:.75}
  .au-rut__head h2{font-size:clamp(2.2rem,5.4vw,3.6rem)}
  .au-rut__head .au-rte{max-width:46ch; opacity:.9}
  .au-rut__steps{list-style:none; margin:0; padding:0; display:grid; gap:10px}
  .au-rut__step{display:grid; grid-template-columns:auto minmax(0,1fr); gap:1rem; align-items:start;
    background:rgba(255,255,255,.55); border-radius:24px; padding:1rem 1.1rem}
  .au-rut__num{display:grid; place-items:center; width:42px; height:42px; border-radius:50%; background:#3B0408; color:#F9D4D3; font-weight:800; font-size:1.15rem; letter-spacing:-.03em}
  .au-rut__txt{display:grid; grid-template-columns:minmax(0,1fr); gap:.35rem; min-width:0}
  .au-rut__txt b{font-size:1.15rem; letter-spacing:-.03em; color:var(--au-pink)}
  .au-rut__txt p{font-size:.94rem; line-height:1.45; color:var(--au-pink-ink)}
  .au-rut__prod{display:inline-flex; align-items:center; gap:.55rem; margin-top:.35rem; padding:.3rem .8rem .3rem .3rem; border-radius:22px;
    background:rgba(59,4,8,.07); text-decoration:none; color:var(--au-pink); font-weight:700; font-size:.84rem; justify-self:start; max-width:100%;
    transition:background .3s}
  .au-rut__prod:hover{background:rgba(59,4,8,.14)}
  .au-sec .au-rut__prod img{width:32px; height:32px; border-radius:50%; object-fit:cover; background:#fff; flex:none}
  .au-rut__prod span{line-height:1.2; min-width:0}
  .au-rut__prod svg{width:16px; height:16px; flex:none}
  @media (max-width:760px){
    .au-rut__grid{grid-template-columns:minmax(0,1fr)}
    .au-rut__photo{aspect-ratio:4/3}
    .au-rut__head{text-align:center; justify-items:center}
  }
</style>

{% schema %}
{
  "name": "Aurum · Rutina",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "capsule",
      "label": "Lugar en la cápsula bordó",
      "default": "start",
      "options": [
        { "value": "start", "label": "Inicio" },
        { "value": "middle", "label": "Medio" },
        { "value": "end", "label": "Final" },
        { "value": "single", "label": "Cápsula sola" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Foto (vertical, con el producto en uso)" },
    { "type": "text", "id": "eyebrow", "label": "Texto chico arriba (opcional)", "default": "Cómo usar Aurum" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tu rutina glow en 3 pasos" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Piel suave, cuidada y con brillo dorado. Tocá cada paso para ver el producto.</p>" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Paso", "default": "Paso" },
        { "type": "textarea", "id": "text", "label": "Texto" },
        { "type": "product", "id": "product", "label": "Producto de este paso" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurum · Rutina",
      "blocks": [
        { "type": "step", "settings": { "label": "Exfoliá", "text": "Con el Scrub dejás la piel suave y pareja, así el glow queda uniforme." } },
        { "type": "step", "settings": { "label": "Protegé", "text": "De día, el protector solar FPS 40 cuida tu piel del sol." } },
        { "type": "step", "settings": { "label": "Brillá", "text": "Maquillaje Corporal en el cuerpo o Sérum Iluminador en clavículas y pómulos: glow dorado al instante." } }
      ]
    }
  ]
}
{% endschema %}
