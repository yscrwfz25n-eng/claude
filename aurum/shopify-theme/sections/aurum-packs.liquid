{%- comment -%}
  Aurum · Promos. Cada bloque es una promo (cantidad + precio final).
  El precio tachado se calcula solo: precio de la unidad del producto × cantidad.
  El botón "Ver" lleva a la página del producto; el descuento lo aplica Shopify con tus descuentos automáticos.
{%- endcomment -%}
{%- assign product = section.settings.product -%}
<section class="au-sec au-sec--{{ section.settings.capsule }}" id="promos">
  <div class="au-head au-reveal">
    {%- if section.settings.heading != blank -%}<h2 class="au-twinkle">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="au-rte">{{ section.settings.text }}</div>{%- endif -%}
  </div>

  {%- if product == blank -%}
    <p class="au-small" style="text-align:center">Elegí el producto en la configuración de esta sección.</p>
  {%- else -%}
    {%- assign variant = product.selected_or_first_available_variant -%}
    <div class="au-card au-packs au-reveal" data-au-packs>
      <div class="au-packs__visual">
        <span class="au-gift" data-au-gift hidden></span>
        {%- if product.featured_media -%}{%- assign fallback_img = product.featured_media | image_url: width: 1000 -%}{%- else -%}{%- assign fallback_img = '' -%}{%- endif -%}
        <img data-au-packimg src="{{ fallback_img }}" width="1000" height="1000" alt="{{ product.title | escape }}" loading="lazy">
      </div>
      <div class="au-packs__info">
        <div class="au-seg" role="group" aria-label="Cantidad de unidades">
          {%- for block in section.blocks -%}
            {%- liquid
              assign qty = block.settings.quantity
              assign price_cents = block.settings.price | times: 100
              assign compare_cents = product.price | times: qty
              assign off = compare_cents | minus: price_cents | times: 100 | divided_by: compare_cents
              assign unit_cents = price_cents | divided_by: qty
              assign cta = 'Ver'
            -%}
            <button type="button" {{ block.shopify_attributes }} data-pack
              data-qty="{{ qty }}" data-price="{{ price_cents | money_without_trailing_zeros }}"
              {% if qty > 1 and off > 0 %}data-compare="{{ compare_cents | money_without_trailing_zeros }}" data-off="{{ off }}" data-unit="{{ unit_cents | money_without_trailing_zeros }}"{% endif %}
              data-ship="{{ block.settings.shipping | escape }}" data-tag="{{ block.settings.badge | escape }}"
              data-gift="{{ block.settings.gift | escape }}" data-cta="{{ cta }}" data-default="{{ block.settings.default }}"
              data-img="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 }}{% else %}{{ fallback_img }}{% endif %}"
              aria-pressed="false">{{ qty }} u</button>
          {%- endfor -%}
        </div>
        <span class="au-tag" data-au-tag hidden></span>
        <div class="au-big" data-au-price>{{ product.price | money_without_trailing_zeros }}</div>
        <div class="au-old" data-au-old></div>
        <div class="au-small" data-au-unit></div>
        <div class="au-ship" data-au-ship></div>
        <input type="hidden" value="1" data-au-qty>
        <a class="au-btn au-btn--wine" href="{{ product.url }}" data-au-cta style="text-decoration:none">Ver</a>
        {%- if section.settings.note != blank -%}<span class="au-small">{{ section.settings.note }}</span>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Aurum · Promos",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "capsule",
      "label": "Lugar en la cápsula bordó",
      "default": "middle",
      "options": [
        {
          "value": "start",
          "label": "Inicio"
        },
        {
          "value": "middle",
          "label": "Medio"
        },
        {
          "value": "end",
          "label": "Final"
        },
        {
          "value": "single",
          "label": "Cápsula sola"
        }
      ]
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Elegí tu promo"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Cuantas más unidades, menos pagás cada una. Con 3 y 4 unidades te regalamos productos de la línea.</p>"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Producto (Resaltador de bronceado)"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota debajo del botón",
      "default": "3 cuotas sin interés · Mercado Pago o tarjeta"
    }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Promo",
      "settings": [
        {
          "type": "range",
          "id": "quantity",
          "label": "Unidades",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 1
        },
        {
          "type": "number",
          "id": "price",
          "label": "Precio final de la promo (en pesos, sin puntos)",
          "default": 39999,
          "info": "Tiene que coincidir con tu descuento automático de Shopify."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen de la promo (cuadrada 1:1)",
          "info": "Ej.: la foto con 3 frascos y la mascarilla. Si la dejás vacía, se usa la foto principal del producto."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Etiqueta (opcional)",
          "info": "Ej.: Recomendado, Mejor precio"
        },
        {
          "type": "text",
          "id": "shipping",
          "label": "Envío y regalos",
          "default": "Envío gratis a sucursal"
        },
        {
          "type": "text",
          "id": "gift",
          "label": "Regalo (aparece sobre el dibujo)",
          "info": "Ej.: Mascarilla de regalo"
        },
        {
          "type": "checkbox",
          "id": "default",
          "label": "Elegida de entrada",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurum · Promos",
      "blocks": [
        {
          "type": "pack",
          "settings": {
            "quantity": 1,
            "price": 39999,
            "shipping": "Envío gratis a sucursal"
          }
        },
        {
          "type": "pack",
          "settings": {
            "quantity": 2,
            "price": 54900,
            "shipping": "Envío gratis a domicilio"
          }
        },
        {
          "type": "pack",
          "settings": {
            "quantity": 3,
            "price": 67900,
            "badge": "Recomendado",
            "shipping": "Envío gratis a domicilio + Mascarilla Fresh Mix de regalo",
            "gift": "Mascarilla de regalo",
            "default": true
          }
        },
        {
          "type": "pack",
          "settings": {
            "quantity": 4,
            "price": 79900,
            "badge": "Mejor precio",
            "shipping": "Envío gratis a domicilio + Mascarilla y Bálsamo de regalo",
            "gift": "Mascarilla y bálsamo de regalo"
          }
        }
      ]
    }
  ]
}
{% endschema %}
