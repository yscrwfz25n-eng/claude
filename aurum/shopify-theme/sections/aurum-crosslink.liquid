{%- comment -%} Aurum · Cruce: tarjeta bordó que lleva a otra página (de Productos a Kits y al revés). {%- endcomment -%}
<section class="au-sec au-sec--{{ section.settings.capsule }} au-x">
  <a class="au-x__card au-reveal{% if section.settings.image == blank %} au-x__card--solo{% endif %}" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
    <div class="au-x__txt">
      {%- if section.settings.eyebrow != blank -%}<span class="au-x__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}<span class="au-btn au-btn--wine">{{ section.settings.button_label }} →</span>{%- endif -%}
    </div>
    {%- if section.settings.image != blank -%}
      <div class="au-x__img">{{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(max-width: 760px) 100vw, 420px', alt: '' }}</div>
    {%- endif -%}
  </a>
</section>

<style>
  .au-sec .au-x__card{display:grid; grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr); align-items:stretch; border-radius:clamp(26px,4vw,40px); overflow:hidden;
    background:#3B0408; color:#F9D4D3; text-decoration:none; transition:transform .4s var(--au-ease)}
  .au-x__card:hover{transform:translateY(-3px)}
  .au-sec .au-x__card--solo{grid-template-columns:minmax(0,1fr); text-align:center}
  .au-x__txt{display:grid; align-content:center; justify-items:start; gap:.8rem; padding:clamp(1.6rem,4vw,2.6rem)}
  .au-x__card--solo .au-x__txt{justify-items:center}
  .au-sec .au-x__eyebrow{font-size:.78rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#F9D4D3; opacity:.7}
  .au-sec .au-x__txt h2{color:#F9D4D3; font-size:clamp(1.9rem,4.4vw,3rem)}
  .au-sec .au-x__txt p{max-width:42ch; line-height:1.45; color:#F9D4D3; opacity:.88}
  .au-x__txt .au-btn{margin-top:.4rem; background:#F9D4D3; color:#3B0408!important}
  .au-x__img{min-height:220px}
  .au-sec .au-x__img img{width:100%; height:100%; object-fit:cover}
  @media (max-width:760px){
    .au-sec .au-x__card{grid-template-columns:minmax(0,1fr)}
    .au-x__img{order:-1; aspect-ratio:16/10; min-height:0}
    .au-x__txt{justify-items:center; text-align:center}
  }
</style>

{% schema %}
{
  "name": "Aurum · Cruce",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "capsule",
      "label": "Lugar en la cápsula bordó",
      "default": "middle",
      "options": [
        { "value": "start", "label": "Inicio" },
        { "value": "middle", "label": "Medio" },
        { "value": "end", "label": "Final" },
        { "value": "single", "label": "Cápsula sola" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Foto (opcional)" },
    { "type": "text", "id": "eyebrow", "label": "Texto chico arriba (opcional)", "default": "Combiná tus favoritos" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Mirá nuestros kits" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Productos que se combinan entre sí, armados para usar juntos o para regalar." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Ver kits" },
    { "type": "url", "id": "button_link", "label": "Link", "info": "Elegí la colección Kits (o Productos, si lo usás en la página de kits)." }
  ],
  "presets": [
    {
      "name": "Aurum · Cruce"
    }
  ]
}
{% endschema %}
