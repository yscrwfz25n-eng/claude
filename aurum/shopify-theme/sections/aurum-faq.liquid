{%- comment -%} Aurum · Preguntas frecuentes: acordeón. Cada pregunta es un bloque. {%- endcomment -%}
<section class="au-sec au-sec--{{ section.settings.capsule }} au-faqh" id="preguntas">
  <div class="au-head au-reveal">
    {%- if section.settings.heading != blank -%}<h2 class="au-twinkle">{{ section.settings.heading }}</h2>{%- endif -%}
  </div>
  <div class="au-faqh__list au-reveal">
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}<span aria-hidden="true">+</span></summary>
        <div class="au-rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

<style>
  .au-faqh__list{max-width:760px; margin:0 auto; display:grid; gap:10px}
  .au-faqh details{background:rgba(255,255,255,.55); border-radius:22px; padding:0 1.2rem}
  .au-faqh summary{list-style:none; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:1rem;
    padding:1.05rem 0; font-weight:700; letter-spacing:-.02em; color:var(--au-pink)}
  .au-faqh summary::-webkit-details-marker{display:none}
  .au-faqh summary span{font-size:1.4rem; line-height:1; transition:transform .3s}
  .au-faqh details[open] summary span{transform:rotate(45deg)}
  .au-faqh details .au-rte{padding:0 0 1.1rem; color:var(--au-pink-ink); line-height:1.5}
</style>

{% schema %}
{
  "name": "Aurum · Preguntas",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "capsule",
      "label": "Lugar en la cápsula bordó",
      "default": "middle",
      "options": [
        { "value": "start", "label": "Inicio" },
        { "value": "middle", "label": "Medio" },
        { "value": "end", "label": "Final" },
        { "value": "single", "label": "Cápsula sola" }
      ]
    },
    { "type": "text", "id": "heading", "label": "Título", "default": "Preguntas frecuentes" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "Pregunta" },
        { "type": "richtext", "id": "answer", "label": "Respuesta", "default": "<p>Respuesta</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aurum · Preguntas",
      "blocks": [
        { "type": "question", "settings": { "question": "¿El resaltador es autobronceante?", "answer": "<p>No. Es un resaltador de bronceado: da un glow dorado al instante y se va con agua y jabón. No tiñe la piel ni hay que esperar horas.</p>" } },
        { "type": "question", "settings": { "question": "¿Mancha la ropa?", "answer": "<p>Dejalo absorber unos minutos antes de vestirte y no mancha la ropa.</p>" } },
        { "type": "question", "settings": { "question": "¿Cuánto tarda el envío?", "answer": "<p>Despachamos en 24–48 hs hábiles a todo el país con seguimiento de Andreani. Retiro gratis en sucursal desde $35.000 y envío gratis a domicilio desde $49.000.</p>" } },
        { "type": "question", "settings": { "question": "¿Cómo puedo pagar?", "answer": "<p>Con Mercado Pago, tarjeta de crédito o débito en cuotas, o transferencia con 10% OFF.</p>" } },
        { "type": "question", "settings": { "question": "¿Puedo cancelar mi compra?", "answer": "<p>Sí. Tenés 10 días corridos desde que recibís tu pedido para arrepentirte de la compra. Escribinos por WhatsApp y te ayudamos.</p>" } }
      ]
    }
  ]
}
{% endschema %}
