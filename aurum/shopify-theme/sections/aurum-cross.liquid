{%- comment -%} Aurum · Cruce: píldora con frase y botón. En Productos lleva a Kits y en Kits lleva a Productos. {%- endcomment -%}
{%- liquid
  assign on_kits = false
  if collection and section.settings.kits_collection != blank and collection.handle == section.settings.kits_collection.handle
    assign on_kits = true
  endif
  if on_kits
    assign target = section.settings.products_collection
    assign q = section.settings.question_on_kits
    assign a = section.settings.answer_on_kits
    assign btn = section.settings.button_on_kits
  else
    assign target = section.settings.kits_collection
    assign q = section.settings.question_on_products
    assign a = section.settings.answer_on_products
    assign btn = section.settings.button_on_products
  endif
-%}
<section class="au-sec au-sec--{{ section.settings.capsule }} au-pill-sec">
  {%- if target == blank -%}
    <p class="au-small" style="text-align:center">Elegí la colección de Productos y la de Kits en la configuración de esta sección.</p>
  {%- else -%}
    <a class="au-pill au-reveal" href="{{ target.url }}">
      {%- if section.settings.photos -%}
        <span class="au-pill__pics" aria-hidden="true">
          {%- for p in target.products limit: 3 -%}
            {%- if p.featured_media -%}{{ p.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
          {%- endfor -%}
        </span>
      {%- endif -%}
      <span class="au-pill__txt"><b>{{ q }}</b> {{ a }}</span>
      {%- if btn != blank -%}<span class="au-pill__btn">{{ btn }} →</span>{%- endif -%}
    </a>
  {%- endif -%}
</section>

<style>
  .au-pill-sec{display:flex; justify-content:center}
  .au-sec .au-pill{display:flex; align-items:center; gap:clamp(.8rem,2vw,1.4rem); max-width:820px; width:100%;
    background:#3B0408; color:#F9D4D3; text-decoration:none; border-radius:999px; padding:.7rem .7rem .7rem clamp(.9rem,2vw,1.2rem);
    transition:transform .4s var(--au-ease)}
  .au-sec .au-pill:hover{transform:translateY(-2px)}
  .au-pill__pics{display:flex; flex:none}
  .au-sec .au-pill__pics img{width:46px; height:46px; border-radius:50%; object-fit:cover; background:#fff; border:2px solid #3B0408; box-shadow:0 0 0 1.5px #F9D4D3}
  .au-sec .au-pill__pics img + img{margin-left:-14px}
  .au-pill__txt{flex:1; min-width:0; font-size:clamp(.98rem,1.8vw,1.15rem); line-height:1.3; letter-spacing:-.02em}
  .au-pill__txt b{font-weight:800}
  .au-pill__btn{flex:none; background:#F9D4D3; color:#3B0408; font-weight:700; font-size:.95rem; letter-spacing:-.02em; padding:.85em 1.4em; border-radius:999px; white-space:nowrap}
  @media (max-width:640px){
    .au-sec .au-pill{flex-direction:column; text-align:center; border-radius:32px; padding:1.1rem}
    .au-pill__btn{width:100%; text-align:center}
  }
</style>

{% schema %}
{
  "name": "Aurum · Cruce",
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "capsule",
      "label": "Lugar en la cápsula bordó",
      "default": "end",
      "options": [
        { "value": "start", "label": "Inicio" },
        { "value": "middle", "label": "Medio" },
        { "value": "end", "label": "Final" },
        { "value": "single", "label": "Cápsula sola" }
      ]
    },
    { "type": "collection", "id": "products_collection", "label": "Colección de Productos" },
    { "type": "collection", "id": "kits_collection", "label": "Colección de Kits" },
    { "type": "checkbox", "id": "photos", "label": "Mostrar mini fotos", "default": true },
    { "type": "header", "content": "En la página de Productos" },
    { "type": "text", "id": "question_on_products", "label": "Pregunta", "default": "¿No sabés cuál elegir?" },
    { "type": "text", "id": "answer_on_products", "label": "Respuesta", "default": "Probá un kit." },
    { "type": "text", "id": "button_on_products", "label": "Botón", "default": "Elegir mi kit" },
    { "type": "header", "content": "En la página de Kits" },
    { "type": "text", "id": "question_on_kits", "label": "Pregunta", "default": "¿Ya tenés tu favorito?" },
    { "type": "text", "id": "answer_on_kits", "label": "Respuesta", "default": "Reponelo acá." },
    { "type": "text", "id": "button_on_kits", "label": "Botón", "default": "Ver productos" }
  ],
  "presets": [
    {
      "name": "Aurum · Cruce"
    }
  ]
}
{% endschema %}
